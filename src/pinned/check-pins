#!/bin/bash

# Report newer releases for the downloads pinned in src/pinned/pinned.toml, with sections ready to paste.
# Downloads a newer release's files into a temporary folder only to checksum them; changes nothing.
# Set GITHUB_TOKEN to avoid GitHub's API limit for anonymous requests.
#
# Usage: task check:pins

set -euo pipefail

# PINNED=<path> checks another copy of the file
PINNED="${PINNED:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/pinned.toml}"
T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT

sha256_of() {
    if command -v sha256sum > /dev/null 2>&1; then
        sha256sum "$1" | awk '{ print $1 }'
    else
        shasum -a 256 "$1" | awk '{ print $1 }'
    fi
}

# "download <name> <repo> <tag>" and "file <name> <platform> <file>" lines, read from the file's fixed
# layout like pin in src/setup/lib.sh
entries() {
    awk '
        function string(line, key,    s) {
            if (!match(line, key " = \"[^\"]*\"")) return ""
            s = substr(line, RSTART, RLENGTH)
            sub(/^[^"]*"/, "", s)
            sub(/"$/, "", s)
            return s
        }
        /^\[/ { section = $0; gsub(/[][ ]/, "", section); if (section !~ /\.files$/) order[++n] = section; next }
        section !~ /\.files$/ && /^repo = / { repo[section] = string($0, "repo") }
        section !~ /\.files$/ && /^tag = / { tag[section] = string($0, "tag") }
        section ~ /\.files$/ && /=/ {
            name = section
            sub(/\.files$/, "", name)
            key = $0
            sub(/ =.*/, "", key)
            gsub(/"/, "", key)
            files[name] = files[name] "file " name " " key " " string($0, "file") "\n"
        }
        END { for (i = 1; i <= n; i++) { s = order[i]; print "download", s, repo[s], tag[s]; printf "%s", files[s] } }
    ' "$PINNED"
}

latest_tag() {
    local auth=()
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
    fi
    # the ${x+...} form keeps bash 3.2 (macOS) from failing on an empty array under set -u
    curl -fsSL ${auth[@]+"${auth[@]}"} "https://api.github.com/repos/$1/releases/latest" \
        | sed -nE 's/^ *"tag_name": *"([^"]+)".*/\1/p'
}

entries > "$T/entries"
outdated=0
unreadable=0
while read -r _ name repo current; do
    if ! latest=$(latest_tag "$repo") || [ -z "$latest" ]; then
        echo "$name ($repo): could not read the latest release" >&2
        unreadable=$((unreadable + 1))
        continue
    fi
    if [ "$latest" = "$current" ]; then
        echo "$name ($repo): $current is the latest release"
        continue
    fi
    outdated=$((outdated + 1))
    printf '%s (%s): %s -> %s; replace its sections in src/pinned/pinned.toml with:\n\n' "$name" "$repo" "$current" "$latest"
    printf '[%s]\nrepo = "%s"\ntag = "%s"\n\n[%s.files]\n' "$name" "$repo" "$latest" "$name"
    while read -r _ _ platform file; do
        asset="${file//\{version\}/${latest#v}}"
        if ! curl -fsSL -o "$T/download" "https://github.com/$repo/releases/download/$latest/$asset"; then
            echo "# $platform: $latest has no $asset; check the release by hand"
            continue
        fi
        key="$platform"
        if [[ "$key" == */* ]]; then
            key="\"$key\""
        fi
        printf '%s = { file = "%s", sha256 = "%s" }\n' "$key" "$file" "$(sha256_of "$T/download")"
    done < <(awk -v name="$name" '$1 == "file" && $2 == name' "$T/entries")
    echo
done < <(awk '$1 == "download"' "$T/entries")

if [ "$unreadable" -gt 0 ]; then
    echo "Could not check $unreadable download(s); try again, or set GITHUB_TOKEN." >&2
    exit 1
fi
if [ "$outdated" -eq 0 ]; then
    echo "All pins are current."
fi
