#!/bin/bash

# Go Environment Setup Script
#
# This script is designed to be run as alias.
#
# Deps: curl, jq
#
# Example: `goenv() { source goenv-scp "$1" "$2" }`
#   $1 - root folder for golang (GOROOT and GOPATH)
#   $2 - golang version in {major.minor.patch} format
#
# If version does not exist in $1/gosdk/go{version}, it will be downloaded and extracted.
# Automatically detects os (linux/darwin) and architecture, choosing correct link from https://go.dev/dl.
#
# Exports GOROOT to $1/gosdk/go$2
# Exports GOPATH to $1/gopath
# Exports GOCACHE to $1/gocache

# The exports only reach the calling shell when this file is sourced.
if ! (return 0 2> /dev/null); then
    echo "Error: source this file instead of running it: source goenv-scp <root-dir> <go-version>" >&2
    exit 1
fi

is_valid_version() {
    local version="$1"
    if [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        return 0
    else
        return 1
    fi
}

find_go_download() {
    local download_url="https://go.dev/dl"
    local version="$1"
    local os_type
    os_type="$(uname | tr '[:upper:]' '[:lower:]')"
    local target_arch
    local json_data

    case "$os_type" in
        darwin) os_type="darwin" ;;
        linux) os_type="linux" ;;
    esac

    if [ -z "$target_arch" ]; then
        local machine
        machine="$(uname -m)"
        case "$machine" in
            x86_64) target_arch="amd64" ;;
            i?86) target_arch="386" ;;
            arm64 | aarch64) target_arch="arm64" ;;
            armv6* | armv7*) target_arch="armv6l" ;;
            ppc64le) target_arch="ppc64le" ;;
            ppc64) target_arch="ppc64" ;;
            s390x) target_arch="s390x" ;;
            mips*)
                if [[ "$(lscpu 2> /dev/null | grep 'Little Endian')" != "" ]]; then
                    target_arch="mipsle"
                else
                    target_arch="mips"
                fi
                ;;
            *)
                echo "Error: Unsupported architecture: $machine" >&2
                return 1
                ;;
        esac
        echo "Auto-detected architecture: $target_arch" >&2
    fi

    if ! json_data=$(curl -fsSL "$download_url/?mode=json&include=all"); then
        echo "Error: could not fetch the Go release list" >&2
        return 1
    fi

    local file_info
    file_info=$(echo "$json_data" | jq -r --arg v "go$version" --arg os "$os_type" --arg arch "$target_arch" \
        '.[] | select(.version == $v) | .files[] | select(.os == $os and .arch == $arch and .kind == "archive")')

    if [ -z "$file_info" ]; then
        echo "Error: No download found for Go $version on $os_type/$target_arch" >&2
        return 1
    fi

    local filename sha256
    filename=$(echo "$file_info" | jq -r '.filename')
    sha256=$(echo "$file_info" | jq -r '.sha256')

    # two words: URL and expected SHA-256
    echo "$download_url/$filename $sha256"
}

sha256_of() {
    if command -v sha256sum > /dev/null 2>&1; then
        sha256sum "$1" | awk '{ print $1 }'
    else
        shasum -a 256 "$1" | awk '{ print $1 }'
    fi
}

find_or_download_go_sdk() {
    local ROOT_DIR="$1"
    local GO_VERSION="$2"
    local SDK_DIR="${ROOT_DIR}/gosdk"

    mkdir -p "$SDK_DIR"

    local exact_dir="${SDK_DIR}/go${GO_VERSION}"
    if [ -d "$exact_dir" ]; then
        echo "go${GO_VERSION}"
        return 0
    fi

    echo "Go SDK version $GO_VERSION not found, downloading..." >&2
    local download download_url expected_sha256
    if ! download=$(find_go_download "$GO_VERSION") || [ -z "$download" ]; then
        echo "Failed to get download URL for Go $GO_VERSION" >&2
        return 1
    fi
    download_url="${download% *}"
    expected_sha256="${download##* }"

    local temp_file
    temp_file=$(mktemp)
    echo "Downloading from: $download_url" >&2

    if ! curl -fL -o "$temp_file" "$download_url"; then
        echo "Download failed" >&2
        rm -f "$temp_file"
        return 1
    fi

    local actual_sha256
    actual_sha256=$(sha256_of "$temp_file")
    if [ "$actual_sha256" != "$expected_sha256" ]; then
        echo "Checksum mismatch: expected $expected_sha256, got $actual_sha256" >&2
        rm -f "$temp_file"
        return 1
    fi
    echo "Checksum verified: $actual_sha256" >&2

    echo "Extracting Go SDK..." >&2

    if [[ "$download_url" == *".tar.gz"* ]]; then
        tar -xzf "$temp_file" -C "$SDK_DIR"
    elif [[ "$download_url" == *".zip"* ]]; then
        unzip -q "$temp_file" -d "$SDK_DIR"
    else
        echo "Unsupported archive format" >&2
        rm -f "$temp_file"
        return 1
    fi

    rm -f "$temp_file"

    if [ -d "${SDK_DIR}/go" ]; then
        local actual_version
        actual_version=$(cat "${SDK_DIR}/go/VERSION" 2> /dev/null | grep -o 'go[0-9]\+\.[0-9]\+\.[0-9]\+' || echo "go${GO_VERSION}")
        mv "${SDK_DIR}/go" "${SDK_DIR}/${actual_version}"
        echo "${actual_version}"
    else
        echo "Extraction failed or unexpected directory structure" >&2
        return 1
    fi

    return 0
}

# Sourced: return to the calling shell instead of exiting it.
if [ $# -ne 2 ]; then
    echo "Usage: $0 <root-dir> <go-version>" >&2
    echo "Example: $0 /opt 1.25.0" >&2
    return 1
fi

ROOT_DIR="$1"
GO_VERSION="$2"

if ! is_valid_version "$GO_VERSION"; then
    echo "Error: $GO_VERSION is not a valid version. Please use the format major.minor.patch"
    return 1
fi

if ! SDK=$(find_or_download_go_sdk "$ROOT_DIR" "$GO_VERSION"); then
    return 1
fi

export GOROOT="${ROOT_DIR}/gosdk/${SDK}"
export GOPATH="${ROOT_DIR}/gopath"
export GOCACHE="${ROOT_DIR}/gocache"
export PATH="${GOROOT}/bin:${GOPATH}/bin:${PATH}"
export GOTOOLCHAIN=local

echo "GOSDK: ${SDK}"
echo "GOROOT: ${GOROOT}"
echo "GOPATH: ${GOPATH}"
echo "GOCACHE: ${GOCACHE}"
echo "GOTOOLCHAIN: ${GOTOOLCHAIN}"
