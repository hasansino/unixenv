#!/bin/bash

# Turn off the terminal modes that remote programs (mc, htop, fzf, vim) switch on: mouse reporting,
# focus events, bracketed paste, the alternate screen, a hidden cursor, application cursor keys and
# keypad, and enhanced keyboard protocols. When a connection drops, the switch back never arrives
# and every mouse move prints escape codes.
#
# Used by the ssh function (src/generic/aliases) and hop after a dropped connection, and by hand on
# a garbled window. Unlike `reset` it keeps the screen and the scrollback.
#
# Usage: term-reset

# Only a terminal understands these; in a pipe or a file they would be noise.
if [ -t 1 ]; then
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l\033[?1004l\033[?2004l'
    printf '\033[?1049l\033[?25h\033[?1l\033>\033[>4m\033[<u'
fi
