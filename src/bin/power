#!/bin/bash
# power: toggle macOS deep sleep (standby and autopoweroff); macOS only, linked by setup there.
#
# Usage: power on|off

if [ "$(uname -s)" != "Darwin" ]; then
    echo "power: macOS only (uses pmset)" >&2
    exit 1
fi

case "${1:-}" in
    on)
        echo "⚡ Enabling performance mode (no standby/autopoweroff)"
        sudo pmset -a standby 0
        sudo pmset -a autopoweroff 0
        ;;
    off)
        echo "🌙 Restoring power-saving defaults"
        sudo pmset -a standby 1
        sudo pmset -a autopoweroff 1
        ;;
    *)
        echo "Usage: power on|off" >&2
        exit 1
        ;;
esac
