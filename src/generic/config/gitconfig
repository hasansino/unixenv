email = 4024450+hasansino@users.noreply.github.com

[help]
# ask before running the command a typo most likely meant
autocorrect = prompt

[core]
excludesfile = ~/.gitignore
editor = nano
autocrlf = input

[credential]
helper = cache

[tag]
forceSignAnnotated = true

[init]
defaultBranch = master

[push]
default = current

[pull]
rebase = false

[color]
ui = auto

[column]
ui = auto

[rerere]
enabled = true

[merge]
# conflict markers also show the common ancestor, without the lines both sides share
conflictStyle = zdiff3

[diff]
algorithm = histogram
# moved lines get their own colors instead of showing as removed and added
colorMoved = zebra

[fetch]
# drop local refs to branches deleted on the remote
prune = true

[rebase]
autosquash = true
autostash = true

[branch]
autoSetupMerge = always
# git branch lists the most recently committed branches first
sort = -committerdate

# delta only if installed; without it git would print an error instead of the diff
[pager]
    diff = "if command -v delta >/dev/null; then delta; else less --tabs=4 -RFX; fi"
    show = "if command -v delta >/dev/null; then delta; else less --tabs=4 -RFX; fi"
    log  = "if command -v delta >/dev/null; then delta; else less --tabs=4 -RFX; fi"

[interactive]
    diffFilter = "if command -v delta >/dev/null; then delta --color-only; else cat; fi"

# delta takes its syntax colors from BAT_THEME (see the shell rc); side by side: `git diff | delta -s`
[delta]
    # n / N jump to the next / previous file in a long diff
    navigate = true
    line-numbers = true

[include]
path = ~/.gitconfig.local
