email = 4024450+hasansino@users.noreply.github.com

[help]
# ask before running the command a typo most likely meant
autocorrect = prompt

[core]
excludesfile = ~/.gitignore
editor = nano
autocrlf = input

[credential]
helper = cache

[tag]
forceSignAnnotated = true

[init]
defaultBranch = master

[push]
default = current

[pull]
rebase = false

[color]
ui = auto

[column]
ui = auto

[rerere]
enabled = true

[merge]
# conflict markers also show the common ancestor, without the lines both sides share
conflictStyle = zdiff3

[diff]
algorithm = histogram
# moved lines get their own colors instead of showing as removed and added
colorMoved = zebra

[fetch]
# drop local refs to branches deleted on the remote
prune = true

[rebase]
autosquash = true
autostash = true

[include]
path = ~/.gitconfig.local

[branch]
autoSetupMerge = always
# git branch lists the most recently committed branches first
sort = -committerdate

[pager]
    diff = diff-so-fancy | less --tabs=4 -RFX
    show = diff-so-fancy | less --tabs=4 -RFX
    log  = diff-so-fancy | less --tabs=4 -RFX

[interactive]
    diffFilter = diff-so-fancy --patch
