# darwin profile
# executed once per login session

# --- homebrew ---

if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# --- PATH ---
# each entry goes in front, so the last one added is searched first: ~/.local/bin, mise's shims, ~/bin, ~/.cargo/bin

if [ -d "$HOME/.cargo/bin" ]; then
    PATH="$HOME/.cargo/bin:$PATH"
fi

if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
fi

# tools installed by mise for setup.light; shims also work in non-interactive shells, such as hop's
if [ -f "$HOME/.config/mise/conf.d/unixenv.toml" ] && [ -d "$HOME/.local/share/mise/shims" ]; then
    PATH="$HOME/.local/share/mise/shims:$PATH"
fi

if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi
