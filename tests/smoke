#!/bin/bash

# Smoke test for setup, or with --light for setup.light.
#
# Runs `setup --no-update` (or `setup.light --no-update`) twice with HOME in a temporary
# directory, then checks that:
# - each managed shell file holds exactly one UNIXENV block, and lines around it keep their position
# - the second run leaves the managed shell files unchanged
# - configuration files and script links are installed; for setup on macOS also the font cask,
#   for setup.light mise and its tools
# - a configuration file changed locally is backed up to .<timestamp>.bak before it is replaced
# - a login interactive shell starts from a bare system PATH without writing to stderr, and finds fzf
#
# setup installs brew packages and casks globally. setup.light writes only to the temporary HOME.
#
# Usage: task test:smoke | task test:smoke:light

set -euo pipefail

LIGHT=false
if [ "${1:-}" = "--light" ]; then
    LIGHT=true
fi
if [ "$LIGHT" = true ]; then
    SETUP_COMMAND=(setup.light --no-update)
else
    SETUP_COMMAND=(setup --no-update)
fi
# The Taskfile points mise at this repository's linters (.tools, etc/mise.toml); setup.light must
# get a default mise, as on a fresh host. XDG folders would also lead outside the temporary HOME
# (GitHub's Ubuntu runners set XDG_CONFIG_HOME, and mise then ignores ~/.config/mise on Linux).
unset MISE_DEFAULT_CONFIG_FILENAME MISE_DATA_DIR MISE_CACHE_DIR MISE_STATE_DIR MISE_CONFIG_DIR
unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SMOKE_HOME="$(mktemp -d)"
WORK_DIR="$(mktemp -d)"

HEADER="#_____UNIXENV_CONFIG_START____"
FOOTER="#_____UNIXENV_CONFIG_END______"
BEFORE_LINE="# smoke: user line before the managed block"
AFTER_LINE="# smoke: user line after the managed block"
LOCAL_EDIT="# smoke: local edit that setup must back up"

if [[ "$OSTYPE" == "darwin"* ]]; then
    MANAGED_FILES=(.zprofile .zshrc .zsh_aliases)
    LOGIN_SHELL=zsh
elif [[ "$OSTYPE" == "linux-gnu" ]]; then
    MANAGED_FILES=(.bash_profile .bashrc .bash_aliases)
    LOGIN_SHELL=bash
else
    echo "Unsupported OS: $OSTYPE" >&2
    exit 1
fi

INSTALLED_FILES=(
    .ssh/config
    .ssh/config_hosts
    .nanorc
    .gitconfig
    .gitconfig.local
    .gitignore
    .config/btm.toml
    .config/htop/htoprc
    .config/eza/theme.yml
    .config/ripgrep/config
    .config/zellij/config.kdl
    .config/mc/ini
    .config/mc/mc.ext.ini
    .docker/config.json
    .hushlogin
)
LINKED_SCRIPTS=(goenv-scp cheat hop term-reset)
if [[ "$OSTYPE" == "darwin"* ]]; then
    LINKED_SCRIPTS+=(power)
else
    LINKED_SCRIPTS+=(motd-quiet)
fi

FAILURES=0
fail() {
    echo "FAIL: $*" >&2
    FAILURES=$((FAILURES + 1))
}

run_setup() {
    echo "==> ${SETUP_COMMAND[*]}"
    HOME="$SMOKE_HOME" "$SMOKE_HOME/unixenv/${SETUP_COMMAND[0]}" "${SETUP_COMMAND[@]:1}"
}

echo "Smoke HOME: $SMOKE_HOME"
# setup reads the repository from $HOME/unixenv
ln -s "$REPO_DIR" "$SMOKE_HOME/unixenv"

for file in "${MANAGED_FILES[@]}"; do
    echo "$BEFORE_LINE" > "$SMOKE_HOME/$file"
done

run_setup

for file in "${MANAGED_FILES[@]}"; do
    echo "$AFTER_LINE" >> "$SMOKE_HOME/$file"
    cp "$SMOKE_HOME/$file" "$WORK_DIR/$file"
done
cmp -s "$REPO_DIR/src/generic/config/gitconfig.local" "$SMOKE_HOME/.gitconfig.local" \
    || fail "the first run did not copy the template to ~/.gitconfig.local"
# the repository file may lack a final newline, so start a new line
printf '\n%s\n' "$LOCAL_EDIT" >> "$SMOKE_HOME/.gitconfig"
# ~/.gitconfig.local is yours after the first run: setup must keep this line
echo "$LOCAL_EDIT" >> "$SMOKE_HOME/.gitconfig.local"

run_setup

echo "==> checking managed shell files"
for file in "${MANAGED_FILES[@]}"; do
    path="$SMOKE_HOME/$file"
    [ "$(grep -cxF "$HEADER" "$path")" -eq 1 ] || fail "$file: expected exactly one block start line"
    [ "$(grep -cxF "$FOOTER" "$path")" -eq 1 ] || fail "$file: expected exactly one block end line"
    [ "$(head -n 1 "$path")" = "$BEFORE_LINE" ] || fail "$file: the line before the block moved"
    [ "$(tail -n 1 "$path")" = "$AFTER_LINE" ] || fail "$file: the line after the block moved"
    if ! diff -u "$WORK_DIR/$file" "$path" >&2; then
        fail "$file: the second setup run changed it"
    fi
done

echo "==> checking installed files"
for file in "${INSTALLED_FILES[@]}"; do
    [ -f "$SMOKE_HOME/$file" ] || fail "missing ~/$file"
done
if [ "$LIGHT" = true ]; then
    [ -x "$SMOKE_HOME/.local/bin/mise" ] || fail "missing ~/.local/bin/mise"
    [ -f "$SMOKE_HOME/.config/mise/conf.d/unixenv.toml" ] || fail "missing ~/.config/mise/conf.d/unixenv.toml"
    # a few tools from each source: aqua and github releases, conda-forge
    for tool in fzf rg zellij tmux git nano mc mosh-server delta; do
        [ -e "$SMOKE_HOME/.local/share/mise/shims/$tool" ] || fail "missing mise shim for $tool"
    done
elif [[ "$OSTYPE" == "darwin"* ]]; then
    # casks install for the whole machine, not into the temporary HOME
    brew list --cask font-cascadia-code > /dev/null 2>&1 || fail "the font-cascadia-code cask is not installed"
fi
for script in "${LINKED_SCRIPTS[@]}"; do
    link="$SMOKE_HOME/.local/bin/$script"
    if [ ! -L "$link" ] || [ ! -x "$link" ]; then
        fail "missing executable link ~/.local/bin/$script"
    fi
done
[ -d "$SMOKE_HOME/.local/state/nano/backups" ] || fail "missing nano backup directory ~/.local/state/nano/backups"
grep -q '^include ".*/share/nano/\*\.nanorc"$' "$SMOKE_HOME/.nanorc" || fail "nano's syntax files are not included in ~/.nanorc"
gitconfig_backups=("$SMOKE_HOME"/.gitconfig.*.bak)
if [ "${#gitconfig_backups[@]}" -ne 1 ] || [ "$(tail -n 1 "${gitconfig_backups[0]}" 2> /dev/null)" != "$LOCAL_EDIT" ]; then
    fail "expected one ~/.gitconfig.<timestamp>.bak holding the local edit"
fi
cmp -s "$REPO_DIR/src/generic/config/gitconfig" "$SMOKE_HOME/.gitconfig" || fail "the repository version did not replace ~/.gitconfig"
if [ "$(tail -n 1 "$SMOKE_HOME/.gitconfig.local")" != "$LOCAL_EDIT" ] || compgen -G "$SMOKE_HOME/.gitconfig.local.*.bak" > /dev/null; then
    fail "the second run changed or backed up ~/.gitconfig.local"
fi

# A bare PATH proves the shell files put the tools on PATH themselves (brew, or mise's shims).
echo "==> starting a login interactive $LOGIN_SHELL"
if ! HOME="$SMOKE_HOME" PATH="/usr/bin:/bin:/usr/sbin:/sbin" \
    "$LOGIN_SHELL" -lic 'command -v fzf' < /dev/null > "$WORK_DIR/fzf" 2> "$WORK_DIR/stderr"; then
    fail "$LOGIN_SHELL failed to start, or did not find fzf"
fi
if [ "$LIGHT" = true ] && ! grep -qF "$SMOKE_HOME/.local/share/mise/shims/fzf" "$WORK_DIR/fzf"; then
    fail "the login shell found fzf outside mise's shims: $(cat "$WORK_DIR/fzf")"
fi
# Without a terminal, bash always reports that job control is unavailable.
if grep -vE '^bash: (cannot set terminal process group|no job control in this shell)' \
    "$WORK_DIR/stderr" > "$WORK_DIR/stderr.filtered"; then
    fail "$LOGIN_SHELL wrote to stderr on startup:"
    cat "$WORK_DIR/stderr.filtered" >&2
fi

if [ "$FAILURES" -gt 0 ]; then
    echo "$FAILURES check(s) failed; HOME kept for inspection: $SMOKE_HOME" >&2
    exit 1
fi
rm -rf "$SMOKE_HOME" "$WORK_DIR"
echo "Smoke test passed."
