#!/bin/bash

# Full setup with Homebrew. Without Homebrew or sudo, use setup.light.
# Shared steps live in src/setup/lib.sh.
#
# Prerequisites: git & homebrew
#
# Install homebrew:
# `/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"`
# + sudo apt-get install build-essential procps curl file

set -e

# --- BOOTSTRAP (same in setup.light) ---
# Piped from curl, bash reads this script from stdin and the repository may not exist yet:
# clone it, then run its copy of this script, which loads the shared steps.
if [ -z "${BASH_SOURCE[0]}" ]; then
    case " $* " in
        *" --no-update "*) ;;
        *) [ -d "$HOME/unixenv" ] || git clone https://github.com/hasansino/unixenv.git "$HOME/unixenv" ;;
    esac
    if [ ! -d "$HOME/unixenv" ]; then
        echo "Error: $HOME/unixenv not found, --no-update needs an existing clone." >&2
        exit 1
    fi
    # stdin holds the rest of this script, so the clone's copy must not inherit it
    exec "$HOME/unixenv/setup" "$@" < /dev/null
fi
SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
# shellcheck source=src/setup/lib.sh
source "$(dirname "$SCRIPT")/src/setup/lib.sh"
# --- BOOTSTRAP END ---

usage() {
    cat << 'EOF'
Usage: setup [--fonts] [--no-update]

  --fonts      also install the Cascadia Code font
  --no-update  use ~/unixenv as it is, without cloning or pulling
  -h, --help   show this help

When piped from curl, pass options after `bash -s --`.
Without Homebrew or sudo, use setup.light.
EOF
}

packages() {
    # Homebrew loads formulas from third-party taps only once they are trusted (stored per user).
    # Trust the single formula the Brewfile needs, not the whole tap; older Homebrew has no such check.
    if brew trust --help > /dev/null 2>&1; then
        brew tap charmbracelet/tap
        brew trust --formula charmbracelet/tap/crush
    fi
    brew bundle --file="$CLONE_DIR/src/Brewfile"
    # Old versions and downloads otherwise pile up after every upgrade.
    brew cleanup --prune=all
    uv tool install -U --python 3.13 posting
    screensavers
}

# Screensavers for alias `ssrs`, as release binaries: building them needs Rust and llvm, about 2.5 GB.
screensavers() {
    local name pinned
    for name in pipes-rs weathr; do
        if pinned=$(pin "$name"); then
            install_release_binary "$name" "${pinned% *}" "${pinned#* }"
        else
            echo "Warning: $name has no build for $(uname -s)/$(uname -m); ssrs runs without it." >&2
        fi
    done
}

fonts() {
    local FONT_NAME="Cascadia Code"
    local ZIP_FILE="CascadiaCode.zip"

    echo "Installing $FONT_NAME font..."

    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        if find "$HOME/.local/share/fonts" /usr/share/fonts -type f -name "*Cascadia*.ttf" 2> /dev/null | grep -q .; then
            echo "✓ $FONT_NAME already installed"
            return 0
        fi
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        if find "$HOME/Library/Fonts" -type f -name "*Cascadia*.ttf" 2> /dev/null | grep -q .; then
            echo "✓ $FONT_NAME already installed"
            return 0
        fi
    fi

    if ! command -v unzip &> /dev/null; then
        echo "Error: unzip is required for font installation."
        return 1
    fi
    local pinned
    pinned=$(pin cascadia)

    local FONT_TMP_DIR
    FONT_TMP_DIR=$(mktemp -d)
    pushd "$FONT_TMP_DIR" > /dev/null

    curl -fsSL -o "$ZIP_FILE" "${pinned% *}"
    if [ "$(sha256_of "$ZIP_FILE")" != "${pinned#* }" ]; then
        echo "Error: checksum mismatch for ${pinned% *}; the font was not installed." >&2
        popd > /dev/null
        rm -rf "$FONT_TMP_DIR"
        return 1
    fi
    unzip -q "$ZIP_FILE"

    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        local FONT_DIR="$HOME/.local/share/fonts"
        mkdir -p "$FONT_DIR"
        find . -name "*.ttf" -exec cp {} "$FONT_DIR" \;
        command -v fc-cache &> /dev/null && fc-cache -fv > /dev/null 2>&1
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        local FONT_DIR="$HOME/Library/Fonts"
        mkdir -p "$FONT_DIR"
        find . -name "*.ttf" -exec cp {} "$FONT_DIR" \;
    else
        echo "Warning: Font installation not supported for OS: $OSTYPE"
        popd > /dev/null
        rm -rf "$FONT_TMP_DIR"
        return 1
    fi

    popd > /dev/null
    rm -rf "$FONT_TMP_DIR"

    echo "✓ $FONT_NAME font installed successfully"
    return 0
}

macos_defaults() {
    # show hidden files in Finder by default
    defaults write com.apple.Finder AppleShowAllFiles true
    # faster dock speed
    defaults write com.apple.dock autohide-delay -float 0
    defaults write com.apple.dock autohide-time-modifier -float 0.15
    # running Dock and Finder keep their old values; setup does not restart them under the user
    echo "Dock and Finder settings take effect after logout (or run: killall Dock Finder)."

    if ! [ -f "/opt/.metadata_never_index" ]; then
        echo "Directory '/opt' is not excluded from spotlight indexing."
        echo "Create '/opt/.metadata_never_index' and run 'mdutil -i off /opt' to exclude it."
    fi
}

parse_args fonts "$@"
check_prerequisites brew
self_update "$SCRIPT" "$@"
enter_tmp_dir

packages
configs
scripts
if [[ "$OSTYPE" == "darwin"* ]]; then
    macos_defaults
fi
if [ "$RUN_FONTS" = true ]; then
    fonts
fi
shell_files

echo "Finished."
