#!/bin/bash

# Full setup with Homebrew.
#
# Prerequisites: git & homebrew
#
# Install homebrew: https://brew.sh/
#
# Linux also needs build tools (https://docs.brew.sh/Homebrew-on-Linux):
#   Debian, Ubuntu:   sudo apt-get install build-essential procps curl file git
#   Fedora:           sudo dnf group install development-tools
#                     sudo dnf install procps-ng curl file git
#   CentOS, RHEL:     sudo dnf group install 'Development Tools'
#                     sudo dnf install procps-ng curl file git
#   Arch:             sudo pacman -S base-devel procps-ng curl file git

set -e

# --- BOOTSTRAP (same in setup.light) ---
# Piped from curl, bash reads this script from stdin and the repository may not exist yet:
# clone it, then run its copy of this script, which loads the shared steps.
if [ -z "${BASH_SOURCE[0]}" ]; then
    case " $* " in
        *" --no-update "*) ;;
        *) [ -d "$HOME/unixenv" ] || git clone https://github.com/hasansino/unixenv.git "$HOME/unixenv" ;;
    esac
    if [ ! -d "$HOME/unixenv" ]; then
        echo "Error: $HOME/unixenv not found, --no-update needs an existing clone." >&2
        exit 1
    fi
    # stdin holds the rest of this script, so the clone's copy must not inherit it
    exec "$HOME/unixenv/setup" "$@" < /dev/null
fi
SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
# shellcheck source=src/setup/lib.sh
source "$(dirname "$SCRIPT")/src/setup/lib.sh"
# --- BOOTSTRAP END ---

usage() {
    cat << 'EOF'
Usage: setup [--no-update]

  --no-update  use ~/unixenv as it is, without cloning or pulling
  -h, --help   show this help

When piped from curl, pass options after `bash -s --`.
Without Homebrew or sudo, use setup.light.
EOF
}

packages() {
    # Homebrew loads formulas from third-party taps only once they are trusted (stored per user).
    # Trust the single formula the Brewfile needs, not the whole tap; older Homebrew has no such check.
    if brew trust --help > /dev/null 2>&1; then
        brew tap charmbracelet/tap
        brew trust --formula charmbracelet/tap/crush
    fi
    brew bundle --file="$CLONE_DIR/src/Brewfile"
    # Old versions and downloads otherwise pile up after every upgrade.
    brew cleanup --prune=all
}

macos_defaults() {
    # show hidden files in Finder by default
    defaults write com.apple.Finder AppleShowAllFiles true
    # faster dock speed
    defaults write com.apple.dock autohide-delay -float 0
    defaults write com.apple.dock autohide-time-modifier -float 0.15
    # running Dock and Finder keep their old values; setup does not restart them under the user
    echo "Dock and Finder settings take effect after logout (or run: killall Dock Finder)."

    if ! [ -f "/opt/.metadata_never_index" ]; then
        echo "Directory '/opt' is not excluded from spotlight indexing."
        echo "Create '/opt/.metadata_never_index' and run 'mdutil -i off /opt' to exclude it."
    fi
}

parse_args "$@"
check_prerequisites brew
self_update "$SCRIPT" "$@"
enter_tmp_dir

packages
configs
scripts
if [[ "$OSTYPE" == "darwin"* ]]; then
    macos_defaults
fi
shell_files

echo "Finished."
