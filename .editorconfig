# @see https://editorconfig.org

root = true

[*]
spelling_language = en-US
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts and dotfiles follow shfmt -i 4 (see SHFMT_FLAGS in Taskfile.yaml).
[{*.sh,setup,tests/smoke,src/ubuntu,src/bin/*,src/macos/power,src/generic/aliases,src/generic/rc,src/linux/bash*,src/macos/z*}]
indent_style = space
indent_size = 4

[*.{yaml,yml,toml,json,md}]
indent_style = space
indent_size = 2
